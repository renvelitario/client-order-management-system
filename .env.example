# The base URL of your backend API server (e.g. http://localhost:5000/api for local development)
VITE_API_BASE_URL=http://localhost:5000/api

# The URL of your Supabase project (Found in Project Settings > API)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Your Supabase public 'anon' key. It is safe to expose this in your frontend client code.
# (Found in Project Settings > API)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
